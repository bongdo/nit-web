#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

target="${1:-${NIT_GUI_DEPLOY_TARGET:-nixos}}"
if [ $# -gt 0 ]; then shift; fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

stop() {
  local pattern="$1" pids pid alive
  pids="$(pgrep -f "$pattern" || true)"
  [ -n "$pids" ] || return 0
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 30); do
    alive=0
    for pid in $pids; do
      kill -0 "$pid" 2>/dev/null && alive=1
    done
    [ "$alive" = 0 ] && return 0
    sleep 0.1
  done
  kill -9 $pids 2>/dev/null || true
}

deploy_nixos() {
  local host="${NIT_GUI_DEPLOY_HOST:-nixos}"
  local port="${NIT_GUI_DEPLOY_PORT:-7791}"
  local remote_dir="${NIT_GUI_DEPLOY_DIR:-Projects/nit-gui}"
  local arch remote_arch
  remote_arch="$(ssh -o ConnectTimeout=10 "$host" uname -m)" || {
    echo "deploy: cannot reach $host" >&2
    return 1
  }
  case "$remote_arch" in
    x86_64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *)
      echo "deploy: unsupported remote architecture: $remote_arch" >&2
      return 1
      ;;
  esac

  CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -trimpath -o "$tmp/nit-gui" .
  scp -q -o ConnectTimeout=10 "$tmp/nit-gui" "$host:$remote_dir/nit-gui.new"

  ssh "$host" bash -s -- "$remote_dir" "$port" <<'REMOTE'
set -euo pipefail
dir="$HOME/$1"
port="$2"
cd "$dir"

mv -f nit-gui.new nit-gui
chmod +x nit-gui

pids="$(pgrep -f "nit-gui --addr 127.0.0.1:$port$" || true)"
if [ -n "$pids" ]; then
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 20); do
    alive=0
    for pid in $pids; do
      if kill -0 "$pid" 2>/dev/null; then alive=1; fi
    done
    [ "$alive" = 0 ] && break
    sleep 0.1
  done
fi

runner=./nit-gui
[ -x ./run ] && runner=./run
setsid "$runner" --addr "127.0.0.1:$port" >nit-gui.log 2>&1 < /dev/null &

for _ in $(seq 1 40); do
  if curl -fsS "http://127.0.0.1:$port/api/health" >/dev/null 2>&1; then
    exit 0
  fi
  sleep 0.2
done

echo "deploy: health check failed" >&2
tail -20 nit-gui.log >&2 || true
exit 1
REMOTE

  echo "deploy: nixos http://127.0.0.1:$port/"
}

deploy_frankfurt() {
  local port="${NIT_GUI_DEPLOY_PORT:-7791}"
  local public_port="${NIT_GUI_PUBLIC_PORT:-7792}"
  local public_host="${NIT_GUI_PUBLIC_HOST:-frankfurt.tailf358cb.ts.net}"
  local base_path="${NIT_GUI_BASE_PATH:-/nit}"
  local run_dir="$PWD/.cache"
  local bin="$run_dir/nit-gui"
  local caddyfile="$run_dir/frankfurt.Caddyfile"
  local auth_env="${NIT_GUI_AUTH_ENV:-$HOME/.config/nit-gui/auth.env}"
  local tailnet_ip=""

  if [ -r "$auth_env" ]; then
    set -a
    . "$auth_env"
    set +a
  fi
  if [ -z "${NIT_GUI_PASSWORD_HASH:-}" ] && [ -z "${NIT_GUI_PASSWORD:-}" ]; then
    echo "deploy: no auth password; run bin/auth first or set NIT_GUI_PASSWORD_HASH" >&2
    return 1
  fi

  tailnet_ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  local allowed="$public_host"
  for candidate in "$tailnet_ip" "$(hostname)" frankfurt; do
    [ -n "$candidate" ] && allowed="$allowed,$candidate"
  done

  mkdir -p "$run_dir"
  go build -trimpath -o "$bin" .
  stop "(^|/)nit-gui --addr 127\.0\.0\.1:$port$"
  if pgrep -f "(^|/)nit-gui --addr 127\.0\.0\.1:$port$" >/dev/null; then
    echo "deploy: port $port is still held by nit-gui" >&2
    return 1
  fi

  if [ -z "${NIT_GUI_LANGUAGETOOL_URL:-}" ] && {
    [ -n "${NIT_GUI_LANGUAGETOOL:-}" ] ||
      command -v languagetool-http-server >/dev/null 2>&1 ||
      command -v nix >/dev/null 2>&1
  }; then
    local grammar_port="${NIT_GUI_LANGUAGETOOL_PORT:-8180}"
    if NIT_GUI_LANGUAGETOOL_PORT="$grammar_port" "$PWD/bin/languagetool" >/dev/null 2>&1; then
      export NIT_GUI_LANGUAGETOOL_URL="http://127.0.0.1:$grammar_port"
      unset NIT_GUI_LANGUAGETOOL
    fi
  fi

  NIT_GUI_ALLOWED_HOSTS="$allowed" NIT_GUI_BASE_PATH="$base_path" setsid "$bin" --addr "127.0.0.1:$port" >"$run_dir/nit-gui.log" 2>&1 < /dev/null &

  local ready=0
  for _ in $(seq 1 40); do
    if curl -fsS "http://127.0.0.1:$port/" >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.2
  done
  if [ "$ready" = 0 ]; then
    echo "deploy: nit-gui did not start" >&2
    tail -20 "$run_dir/nit-gui.log" >&2 || true
    return 1
  fi

  cat >"$caddyfile" <<EOF
{
	auto_https off
	admin off
}

127.0.0.1:$public_port {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "microphone=(self)"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
	}
	handle_path $base_path/* {
		reverse_proxy 127.0.0.1:$port
	}
	handle {
		reverse_proxy 127.0.0.1:$port
	}
}
EOF

  caddy validate --config "$caddyfile" --adapter caddyfile >/dev/null
  stop "caddy run --config $caddyfile"
  setsid caddy run --config "$caddyfile" --adapter caddyfile >"$run_dir/frankfurt-caddy.log" 2>&1 < /dev/null &

  ready=0
  for _ in $(seq 1 40); do
    code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$public_port$base_path/" || true)"
    if [ "$code" = 303 ] || [ "$code" = 302 ] || [ "$code" = 200 ]; then
      ready=1
      break
    fi
    sleep 0.2
  done
  if [ "$ready" = 0 ]; then
    echo "deploy: public listener did not start" >&2
    tail -20 "$run_dir/frankfurt-caddy.log" >&2 || true
    return 1
  fi

  tailnet_ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  echo "deploy: local http://127.0.0.1:$public_port$base_path/"
  if [ -n "$tailnet_ip" ]; then
    echo "deploy: tailnet http://$tailnet_ip:$public_port$base_path/"
  fi
  echo "deploy: public https://$public_host$base_path/"
  if ! tailscale funnel status 2>/dev/null | grep -q "$public_port"; then
    echo "deploy: enable public access with: sudo tailscale funnel --bg --set-path $base_path $public_port"
  fi
}

case "$target" in
  nixos | frankfurt) ;;
  *)
    echo "usage: deploy [nixos|frankfurt]" >&2
    exit 2
    ;;
esac

npm --prefix web run build

case "$target" in
  nixos) deploy_nixos ;;
  frankfurt) deploy_frankfurt ;;
esac
