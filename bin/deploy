#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

port="${NIT_GUI_DEPLOY_PORT:-7791}"
public_host="${NIT_GUI_PUBLIC_HOST:-frankfurt.tailf358cb.ts.net}"
domain="${NIT_GUI_DOMAIN-bongdo.space}"
base_path="${NIT_GUI_BASE:-/nit/}"
base_path="${base_path%/}"
run_dir="$PWD/.cache"
bin="$run_dir/nit-gui"
caddyfile="$run_dir/frankfurt.Caddyfile"
auth_env="${NIT_GUI_AUTH_ENV:-$HOME/.config/nit-gui/auth.env}"
tailnet_ip=""
code=""

common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
primary="$(dirname "${common:-$PWD}")"
if [ -z "${NIT_GUI_DEPLOY_ANY:-}" ] && [ -n "$common" ] && [ "$PWD" != "$primary" ]; then
  echo "deploy: only $primary owns the live service; this is $PWD. Merge into the main worktree to deploy." >&2
  exit 1
fi

mkdir -p "$run_dir"
exec 9>"${TMPDIR:-/tmp}/nit-gui-deploy-$port.lock"
flock -w 600 9

stop() {
  local pattern="$1" pids pid alive
  pids="$(pgrep -f "$pattern" || true)"
  [ -n "$pids" ] || return 0
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 30); do
    alive=0
    for pid in $pids; do
      kill -0 "$pid" 2>/dev/null && alive=1
    done
    [ "$alive" = 0 ] && return 0
    sleep 0.1
  done
  kill -9 $pids 2>/dev/null || true
}

if [ -r "$auth_env" ]; then
  set -a
  . "$auth_env"
  set +a
fi
if [ -z "${NIT_GATE_PASSWORD_HASH:-}" ] && [ -z "${NIT_GUI_PASSWORD_HASH:-}" ] &&
  [ -z "${NIT_GATE_PASSWORD:-}" ] && [ -z "${NIT_GUI_PASSWORD:-}" ]; then
  echo "deploy: no auth password; run bin/auth first or set NIT_GATE_PASSWORD_HASH" >&2
  exit 1
fi

tailnet_ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
allowed="$public_host"
for candidate in "$tailnet_ip" "$(hostname)" frankfurt; do
  [ -n "$candidate" ] && allowed="$allowed,$candidate"
done
if [ -n "$domain" ]; then
  allowed="$allowed,$domain,www.$domain"
fi

NIT_GUI_BASE="$base_path/" npm --prefix web run build
mkdir -p "$run_dir"
go build -trimpath -o "$bin" .

if [ -z "$domain" ]; then
  echo "deploy: NIT_GUI_DOMAIN is required; the ts.net entry is gone" >&2
  exit 1
fi
listen_addr="$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 != "tailscale0" {print $4}' | cut -d/ -f1 | head -1)"
listen_addr="${listen_addr:-0.0.0.0}"

routes_file="${NIT_GATE_ROUTES:-${XDG_CONFIG_HOME:-$HOME/.config}/nit-gui/routes.json}"
if [ ! -r "$routes_file" ]; then
  echo "deploy: gate routes not found at $routes_file" >&2
  exit 1
fi
gate_pid="$(pgrep -f '(^|/)\.cache/gate --addr' | head -1 || true)"
if [ -z "$gate_pid" ]; then
  echo "deploy: the gate is not running; start it with bin/gate" >&2
  exit 1
fi

live_port="$(python3 - "$routes_file" <<'PY'
import json, sys
try:
    routes = json.load(open(sys.argv[1]))["routes"]
except Exception:
    sys.exit(0)
for route in routes:
    if route.get("prefix") == "/nit":
        print(route["upstream"].rsplit(":", 1)[-1])
        break
PY
)"
live_port="${live_port:-$port}"
share_route="$(python3 - "$routes_file" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
print("yes" if any(route.get("prefix") == "/share" for route in data["routes"]) else "")
PY
)"

next_port=""
for candidate in 7791 7792 7794 7797 7798 7804 7805 7806; do
  [ "$candidate" = "$live_port" ] && continue
  if ! ss -ltn "sport = :$candidate" | grep -q LISTEN; then
    next_port="$candidate"
    break
  fi
done
if [ -z "$next_port" ]; then
  echo "deploy: no free loopback port for the new build" >&2
  exit 1
fi

if [ -z "${NIT_GUI_LANGUAGETOOL_URL:-}" ] && {
  [ -n "${NIT_GUI_LANGUAGETOOL:-}" ] ||
    command -v languagetool-http-server >/dev/null 2>&1 ||
    command -v nix >/dev/null 2>&1
}; then
  grammar_port="${NIT_GUI_LANGUAGETOOL_PORT:-8180}"
  if NIT_GUI_LANGUAGETOOL_PORT="$grammar_port" "$PWD/bin/languagetool" >/dev/null 2>&1; then
    export NIT_GUI_LANGUAGETOOL_URL="http://127.0.0.1:$grammar_port"
    unset NIT_GUI_LANGUAGETOOL
  fi
fi

term_url="${NIT_GUI_TERM_URL:-/term/}"
NIT_GUI_TERM_URL="$term_url" \
  NIT_GUI_ALLOWED_HOSTS="$allowed" NIT_GUI_BASE_PATH="$base_path" NIT_GUI_PUBLIC_HOST="$public_host" \
  setsid "$bin" --addr "127.0.0.1:$next_port" >"$run_dir/nit-gui.log" 2>&1 < /dev/null 9>&- &

ready=0
for _ in $(seq 1 40); do
  if curl -fsS "http://127.0.0.1:$next_port/" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 0.2
done
if [ "$ready" = 0 ]; then
  echo "deploy: the new build did not start" >&2
  tail -20 "$run_dir/nit-gui.log" >&2
  stop "(^|/)nit-gui --addr 127\.0\.0\.1:$next_port$"
  exit 1
fi

gate_log="$run_dir/gate.log"
cp -f "$routes_file" "$run_dir/routes.json.bak"

switch_routes() {
  python3 - "$routes_file" "$1" <<'PY'
import json, sys
path, port = sys.argv[1], sys.argv[2]
with open(path) as handle:
    data = json.load(handle)
for route in data["routes"]:
    if route.get("prefix") in ("/nit", "/share"):
        route["upstream"] = "http://127.0.0.1:" + port
with open(path + ".tmp", "w") as handle:
    json.dump(data, handle, ensure_ascii=False, indent=2)
    handle.write("\n")
PY
  mv "$routes_file.tmp" "$routes_file"
}

reload_gate() {
  local before=0
  [ -r "$gate_log" ] && before="$(grep -c "" "$gate_log" || true)"
  kill -HUP "$gate_pid" 2>/dev/null || return 1
  [ -r "$gate_log" ] || { sleep 0.3; return 0; }
  for _ in $(seq 1 20); do
    if [ "$(grep -c "" "$gate_log" || true)" -gt "$before" ] && tail -5 "$gate_log" | grep -q "routes reloaded"; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

public_code() {
  [ -n "$share_route" ] || return 0
  curl -s -o /dev/null -w '%{http_code}' --resolve "$domain:443:$listen_addr" "https://$domain/share/" || true
}

keep_old() {
  echo "deploy: $1; keeping the old build" >&2
  cp -f "$run_dir/routes.json.bak" "$routes_file"
  reload_gate || true
  stop "(^|/)nit-gui --addr 127\.0\.0\.1:$next_port$"
  exit 1
}

switch_routes "$next_port"
reload_gate || keep_old "the gate did not reload routes"
if [ -n "$share_route" ]; then
  code="$(public_code)"
  [ "$code" = "303" ] || [ "$code" = "200" ] || keep_old "the switched route answered $code"
fi

stop "(^|/)nit-gui --addr 127\.0\.0\.1:$live_port$"
if [ -n "$share_route" ]; then
  code="$(public_code)"
  if [ "$code" != "303" ] && [ "$code" != "200" ]; then
    echo "deploy: the public route answered $code after stopping the old build" >&2
    tail -20 "$run_dir/nit-gui.log" >&2
    exit 1
  fi
fi

cat >"$caddyfile.next" <<EOF
{
	admin off
}

$domain, www.$domain {
	bind $listen_addr
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	reverse_proxy 127.0.0.1:8090
}
EOF

if cmp -s "$caddyfile.next" "$caddyfile" && pgrep -f "caddy run --config .*frankfurt\.Caddyfile" >/dev/null; then
  rm -f "$caddyfile.next"
else
  mv "$caddyfile.next" "$caddyfile"
  caddy validate --config "$caddyfile" --adapter caddyfile >/dev/null
  stop "caddy run --config .*frankfurt\.Caddyfile"
  setsid caddy run --config "$caddyfile" --adapter caddyfile >"$run_dir/frankfurt-caddy.log" 2>&1 < /dev/null 9>&- &
fi

ready=0
for _ in $(seq 1 40); do
  code="$(curl -s -o /dev/null -w '%{http_code}' --resolve "$domain:443:$listen_addr" "https://$domain$base_path/" || true)"
  if [ "$code" = 303 ] || [ "$code" = 302 ] || [ "$code" = 200 ]; then
    ready=1
    break
  fi
  sleep 0.2
done
if [ "$ready" = 0 ]; then
  echo "deploy: domain listener did not start" >&2
  tail -20 "$run_dir/frankfurt-caddy.log" >&2
  exit 1
fi

echo "deploy: https://$domain$base_path/"
