#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

base="${NIT_GUI_GIGAAM_HOME:-$HOME/.local/opt/gigaam}"
port="${NIT_GUI_GIGAAM_PORT:-8177}"
archive="sherpa-onnx-nemo-ctc-punct-giga-am-v3-russian-2025-12-16"
model_dir="$base/models/giga-am-v3-punct"
url="https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/$archive.tar.bz2"
script="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

healthy() {
  curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1
}

ensure() {
  if [ ! -x "$base/venv/bin/python" ]; then
    python3 -m venv "$base/venv"
    "$base/venv/bin/pip" install --quiet --upgrade pip
    "$base/venv/bin/pip" install --quiet sherpa-onnx numpy
  fi
  if [ ! -f "$model_dir/model.int8.onnx" ]; then
    local tmp
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    curl -L --fail -o "$tmp/model.tar.bz2" "$url"
    tar -xjf "$tmp/model.tar.bz2" -C "$tmp"
    mkdir -p "$base/models"
    mv "$tmp/$archive" "$model_dir"
    rm -rf "$tmp"
    trap - EXIT
  fi
}

case "${1:-ensure}" in
  run)
    ensure
    exec "$base/venv/bin/python" tools/gigaam.py \
      --model "$model_dir/model.int8.onnx" \
      --tokens "$model_dir/tokens.txt" \
      --port "$port" \
      --threads "${NIT_GUI_GIGAAM_THREADS:-2}"
    ;;
  ensure)
    ensure
    healthy && exit 0
    mkdir -p .cache
    setsid "$script" run >.cache/gigaam.log 2>&1 </dev/null &
    for _ in $(seq 1 100); do
      healthy && exit 0
      sleep 0.2
    done
    echo "gigaam: did not start on $port" >&2
    tail -20 .cache/gigaam.log >&2 || true
    exit 1
    ;;
  stop)
    pkill -f "tools/gigaam.py --model" 2>/dev/null || true
    ;;
  *)
    echo "usage: bin/gigaam [run|ensure|stop]" >&2
    exit 2
    ;;
esac
