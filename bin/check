#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -d web/node_modules ]; then
  npm --prefix web ci --no-audit --no-fund
fi

npm --prefix web run typecheck
npm --prefix web run test
npm --prefix web run build

out="$(gofmt -l main.go internal cmd)"
[ -z "$out" ] || { printf 'gofmt:\n%s\n' "$out" >&2; exit 1; }
go vet ./...
go test -race ./...
mkdir -p .cache
go build -o .cache/nit-gui-check .
