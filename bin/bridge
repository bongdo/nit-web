#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

gate_url="${NIT_GATE_URL:-http://127.0.0.1:8090}"
server="${NIT_BRIDGE_SERVER:-wss://bongdo.space/agent}"
opencode="${NIT_BRIDGE_OPENCODE:-http://127.0.0.1:49374}"
gate_key="${NIT_GATE_KEY:-${XDG_CONFIG_HOME:-$HOME/.config}/nit-gui/gate.key}"
remote_bin=".local/bin/nit-bridge"
unit=".config/systemd/user/nit-bridge.service"

usage() {
  cat <<'EOF'
bridge — install and inspect machine bridges

  bridge add <ssh-host>   copy the bridge, install the systemd user unit, wait for it
  bridge token <name>     mint a machine token and print the bridge config
  bridge status           machines known to the gate and whether they are online
  bridge rm <ssh-host>    disable and remove the bridge on the host and the token here
EOF
}

name_for() {
  printf '%s' "${1%%.*}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | cut -c1-32
}

identity() {
  local secret body sig
  secret="$(cat "$gate_key")"
  body="$(printf '{"u":"bridge","r":"admin","c":["read.public","read.private","write.own","write.shared","admin.users","admin.host"],"exp":%s}' "$(($(date +%s) + 60))" |
    base64 -w0 | tr '+/' '-_' | tr -d '=')"
  sig="$(printf '%s' "$body" |
    openssl dgst -sha256 -mac HMAC -macopt "hexkey:$(printf '%s' "$secret" | od -An -tx1 -v | tr -d ' \n')" -binary |
    base64 -w0 | tr '+/' '-_' | tr -d '=')"
  printf '%s.%s' "$body" "$sig"
}

agents() {
  curl -fsS -H "X-Gate-Identity: $(identity)" "$gate_url/api/agents"
}

status() {
  agents | tr '{' '\n' | while read -r row; do
    state=""
    case "$row" in
    *'"online":true'*) state="online" ;;
    *'"online":false'*) state="offline" ;;
    *) continue ;;
    esac
    name="$(printf '%s' "$row" | sed -n 's/^"name":"\([^"]*\)".*/\1/p')"
    printf '%-16s %s\n' "$name" "$state"
  done
}

mint_token() {
  go run ./cmd/gate token rm "$1" >/dev/null 2>&1 || true
  go run ./cmd/gate token add "$1"
}

wait_online() {
  local name="$1"
  for _ in $(seq 1 30); do
    case "$(agents || true)" in
    *"\"name\":\"$name\",\"online\":true"*)
      echo "bridge: $name is online"
      return 0
      ;;
    esac
    sleep 1
  done
  echo "bridge: $name did not connect; check systemctl --user status nit-bridge on the host" >&2
  return 1
}

add() {
  local host="$1" name arch goarch token
  name="$(name_for "$host")"
  arch="$(ssh "$host" uname -m)"
  case "$arch" in
  x86_64 | amd64) goarch=amd64 ;;
  aarch64 | arm64) goarch=arm64 ;;
  armv7l) goarch=arm ;;
  *)
    echo "bridge: unsupported architecture $arch on $host" >&2
    return 1
    ;;
  esac
  token="$(mint_token "$name")"
  mkdir -p .cache
  GOOS=linux GOARCH="$goarch" CGO_ENABLED=0 go build -trimpath -o .cache/nit-bridge ./cmd/bridge
  ssh "$host" "mkdir -p ~/$(dirname "$remote_bin") ~/$(dirname "$unit") ~/.config/nit-bridge"
  scp -q .cache/nit-bridge "$host:~/$remote_bin"
  ssh "$host" "chmod 755 ~/$remote_bin"
  printf '{"server":"%s","name":"%s","token":"%s","opencode":"%s","targets":[]}' \
    "$server" "$name" "$token" "$opencode" |
    ssh "$host" "umask 077; cat > ~/.config/nit-bridge/config.json"
  if ssh "$host" "test -f /etc/systemd/user/nit-bridge.service"; then
    ssh "$host" "systemctl --user daemon-reload && systemctl --user restart nit-bridge"
  else
    ssh "$host" "cat > ~/$unit" <<EOF
[Unit]
Description=nit bridge
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/$remote_bin
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
EOF
    ssh "$host" "systemctl --user daemon-reload && systemctl --user enable --now nit-bridge"
  fi
  ssh "$host" "loginctl enable-linger \$(id -un)"
  echo "bridge: $name installed on $host"
  wait_online "$name"
}

token() {
  local name token
  name="$(name_for "$1")"
  token="$(mint_token "$name")"
  echo "token: $token"
  printf 'config: {"server":"%s","name":"%s","token":"%s","opencode":"%s","targets":[]}\n' \
    "$server" "$name" "$token" "$opencode"
}

remove_host() {
  local host="$1" name
  name="$(name_for "$host")"
  ssh "$host" "systemctl --user disable --now nit-bridge || true
    rm -f ~/$unit ~/$remote_bin ~/.config/nit-bridge/config.json
    systemctl --user daemon-reload || true" || true
  go run ./cmd/gate token rm "$name"
}

case "${1:-}" in
add)
  [ $# -eq 2 ] || {
    usage
    exit 1
  }
  add "$2"
  ;;
token)
  [ $# -eq 2 ] || {
    usage
    exit 1
  }
  token "$2"
  ;;
status) status ;;
rm)
  [ $# -eq 2 ] || {
    usage
    exit 1
  }
  remove_host "$2"
  ;;
*)
  usage
  exit 1
  ;;
esac
