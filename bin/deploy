#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

port="${NIT_GUI_DEPLOY_PORT:-7791}"
public_host="${NIT_GUI_PUBLIC_HOST:-frankfurt.tailf358cb.ts.net}"
domain="${NIT_GUI_DOMAIN-bongdo.space}"
base_path="${NIT_GUI_BASE:-/nit/}"
base_path="${base_path%/}"
run_dir="$PWD/.cache"
bin="$run_dir/nit-gui"
caddyfile="$run_dir/frankfurt.Caddyfile"
auth_env="${NIT_GUI_AUTH_ENV:-$HOME/.config/nit-gui/auth.env}"
tailnet_ip=""
code=""

mkdir -p "$run_dir"
exec 9>"$run_dir/deploy.lock"
flock -w 600 9

stop() {
  local pattern="$1" pids pid alive
  pids="$(pgrep -f "$pattern" || true)"
  [ -n "$pids" ] || return 0
  kill $pids 2>/dev/null || true
  for _ in $(seq 1 30); do
    alive=0
    for pid in $pids; do
      kill -0 "$pid" 2>/dev/null && alive=1
    done
    [ "$alive" = 0 ] && return 0
    sleep 0.1
  done
  kill -9 $pids 2>/dev/null || true
}

if [ -r "$auth_env" ]; then
  set -a
  . "$auth_env"
  set +a
fi
if [ -z "${NIT_GATE_PASSWORD_HASH:-}" ] && [ -z "${NIT_GUI_PASSWORD_HASH:-}" ] &&
  [ -z "${NIT_GATE_PASSWORD:-}" ] && [ -z "${NIT_GUI_PASSWORD:-}" ]; then
  echo "deploy: no auth password; run bin/auth first or set NIT_GATE_PASSWORD_HASH" >&2
  exit 1
fi

tailnet_ip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
allowed="$public_host"
for candidate in "$tailnet_ip" "$(hostname)" frankfurt; do
  [ -n "$candidate" ] && allowed="$allowed,$candidate"
done
if [ -n "$domain" ]; then
  allowed="$allowed,$domain,www.$domain"
fi

NIT_GUI_BASE="$base_path/" npm --prefix web run build
mkdir -p "$run_dir"
go build -trimpath -o "$bin" .
stop "(^|/)nit-gui --addr 127\.0\.0\.1:$port$"
if pgrep -f "(^|/)nit-gui --addr 127\.0\.0\.1:$port$" >/dev/null; then
  echo "deploy: port $port is still held by nit-gui" >&2
  exit 1
fi

if [ -z "${NIT_GUI_LANGUAGETOOL_URL:-}" ] && {
  [ -n "${NIT_GUI_LANGUAGETOOL:-}" ] ||
    command -v languagetool-http-server >/dev/null 2>&1 ||
    command -v nix >/dev/null 2>&1
}; then
  grammar_port="${NIT_GUI_LANGUAGETOOL_PORT:-8180}"
  if NIT_GUI_LANGUAGETOOL_PORT="$grammar_port" "$PWD/bin/languagetool" >/dev/null 2>&1; then
    export NIT_GUI_LANGUAGETOOL_URL="http://127.0.0.1:$grammar_port"
    unset NIT_GUI_LANGUAGETOOL
  fi
fi

term_url="${NIT_GUI_TERM_URL:-/term/}"
NIT_GUI_TERM_URL="$term_url" \
  NIT_GUI_ALLOWED_HOSTS="$allowed" NIT_GUI_BASE_PATH="$base_path" NIT_GUI_PUBLIC_HOST="$public_host" setsid "$bin" --addr "127.0.0.1:$port" >"$run_dir/nit-gui.log" 2>&1 < /dev/null &

ready=0
for _ in $(seq 1 40); do
  if curl -fsS "http://127.0.0.1:$port/" >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 0.2
done
if [ "$ready" = 0 ]; then
  echo "deploy: nit-gui did not start" >&2
  tail -20 "$run_dir/nit-gui.log" >&2
  exit 1
fi

if [ -z "$domain" ]; then
  echo "deploy: NIT_GUI_DOMAIN is required; the ts.net entry is gone" >&2
  exit 1
fi
listen_addr="$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 != "tailscale0" {print $4}' | cut -d/ -f1 | head -1)"
listen_addr="${listen_addr:-0.0.0.0}"

cat >"$caddyfile.next" <<EOF
{
	admin off
}

$domain, www.$domain {
	bind $listen_addr
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	reverse_proxy 127.0.0.1:8090
}
EOF

if cmp -s "$caddyfile.next" "$caddyfile" && pgrep -f "caddy run --config $caddyfile" >/dev/null; then
  rm -f "$caddyfile.next"
else
  mv "$caddyfile.next" "$caddyfile"
  caddy validate --config "$caddyfile" --adapter caddyfile >/dev/null
  stop "caddy run --config $caddyfile"
  setsid caddy run --config "$caddyfile" --adapter caddyfile >"$run_dir/frankfurt-caddy.log" 2>&1 < /dev/null &
fi

ready=0
for _ in $(seq 1 40); do
  code="$(curl -s -o /dev/null -w '%{http_code}' --resolve "$domain:443:$listen_addr" "https://$domain$base_path/" || true)"
  if [ "$code" = 303 ] || [ "$code" = 302 ] || [ "$code" = 200 ]; then
    ready=1
    break
  fi
  sleep 0.2
done
if [ "$ready" = 0 ]; then
  echo "deploy: domain listener did not start" >&2
  tail -20 "$run_dir/frankfurt-caddy.log" >&2
  exit 1
fi

echo "deploy: https://$domain$base_path/"
