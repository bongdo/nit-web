#!/usr/bin/env bash
set -uo pipefail

routes="${NIT_GATE_ROUTES:-${XDG_CONFIG_HOME:-$HOME/.config}/nit-gui/routes.json}"
port="$(python3 - "$routes" <<'PY' 2>/dev/null
import json, sys
for route in json.load(open(sys.argv[1]))["routes"]:
    if route.get("prefix") == "/nit":
        print(route["upstream"].rsplit(":", 1)[-1])
        break
PY
)"
url="${NIT_GUI_UPTIME_URL:-http://127.0.0.1:${port:-7791}/}"
interval="${NIT_GUI_UPTIME_INTERVAL:-5}"
seconds="${1:-0}"
deadline=$(( $(date +%s) + seconds ))

down_since=0
downs=0
total=0
worst=0

while :; do
  now=$(date +%s)
  if [ "$seconds" != "0" ] && [ "$now" -ge "$deadline" ]; then break; fi
  if curl -s -o /dev/null --max-time 2 "$url"; then
    if [ "$down_since" != 0 ]; then
      spent=$((now - down_since))
      total=$((total + spent))
      [ "$spent" -gt "$worst" ] && worst=$spent
      printf 'up   %s after %ss\n' "$(date +%H:%M:%S)" "$spent"
      down_since=0
    fi
  elif [ "$down_since" = 0 ]; then
    down_since=$now
    downs=$((downs + 1))
    printf 'down %s\n' "$(date +%H:%M:%S)"
  fi
  sleep "$interval"
done

if [ "$down_since" != 0 ]; then
  spent=$(( $(date +%s) - down_since ))
  total=$((total + spent))
  [ "$spent" -gt "$worst" ] && worst=$spent
fi

printf '%d outages, %ss total, worst %ss\n' "$downs" "$total" "$worst"
